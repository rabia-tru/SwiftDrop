<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: the launcher's foreground mark (motorcycle)
     reproduced in the 288x288dp splash icon viewport, scaled and positioned
     so it reads at the same size as the icon on the launcher / Flutter splash.
     Drawn white+orange — identical mark to ic_launcher_foreground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- Soft white glow disc behind the mark (as on the launcher foreground) -->
    <path
        android:fillColor="#1AFFFFFF"
        android:pathData="M144,144 m-93.3,0 a93.3,93.3 0 1,1 186.6,0 a93.3,93.3 0 1,1 -186.6,0" />

    <!-- Motorcycle artwork, scaled 2.667x from the 108dp launcher foreground -->
    <group
        android:translateX="64"
        android:translateY="58.7"
        android:scaleX="1.8667"
        android:scaleY="1.8667">

        <!-- Rear wheel -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M22,58 m-11,0 a11,11 0 1,1 22,0 a11,11 0 1,1 -22,0" />
        <path
            android:fillColor="#FF6D00"
            android:pathData="M22,58 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0" />

        <!-- Front wheel -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M62,58 m-11,0 a11,11 0 1,1 22,0 a11,11 0 1,1 -22,0" />
        <path
            android:fillColor="#FF6D00"
            android:pathData="M62,58 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0" />

        <!-- Frame body -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M22,58 L30,38 L55,32 L62,38 L62,52 L22,52 Z" />

        <!-- Fuel tank -->
        <path
            android:fillColor="#FF8F00"
            android:pathData="M32,36 Q42,28 52,34 L48,40 Q38,36 32,36 Z" />

        <!-- Seat -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M28,38 L48,34 L48,38 L28,42 Z" />

        <!-- Handlebar -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:pathData="M52,28 L62,22"
            android:fillColor="#00000000" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:pathData="M58,20 L66,20"
            android:fillColor="#00000000" />

        <!-- Headlight -->
        <path
            android:fillColor="#FFEB3B"
            android:pathData="M62,34 m-4,0 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0" />

        <!-- Exhaust pipe -->
        <path
            android:fillColor="#BDBDBD"
            android:pathData="M18,52 L24,52 L24,56 L16,56 Z" />

        <!-- Delivery box on back -->
        <path
            android:fillColor="#FF6D00"
            android:pathData="M14,24 L34,24 L34,42 L14,42 Z" />

        <!-- Box stripe -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M18,30 L30,30 L30,34 L18,34 Z" />

        <!-- Box lid -->
        <path
            android:fillColor="#E65100"
            android:pathData="M12,22 L36,22 L36,26 L12,26 Z" />

        <!-- Lightning bolt on box (speed symbol) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M24,28 L20,36 L24,36 L22,40 L28,32 L24,32 L26,28 Z" />

        <!-- Speed lines -->
        <path
            android:strokeColor="#1AFFFFFF"
            android:strokeWidth="2"
            android:pathData="M4,36 L12,36"
            android:fillColor="#00000000" />
        <path
            android:strokeColor="#1AFFFFFF"
            android:strokeWidth="2"
            android:pathData="M6,42 L14,42"
            android:fillColor="#00000000" />
        <path
            android:strokeColor="#1AFFFFFF"
            android:strokeWidth="2"
            android:pathData="M2,48 L10,48"
            android:fillColor="#00000000" />
    </group>
</vector>
