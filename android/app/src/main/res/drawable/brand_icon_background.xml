<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background layer: deep-blue 135-degree brand gradient.
     Full-bleed 108x108 so every mask shape (circle, squircle, rounded
     square) is covered with no visible edges. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="@color/brand_icon_background_start" />
                <item android:offset="1.0" android:color="@color/brand_icon_background_end" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
