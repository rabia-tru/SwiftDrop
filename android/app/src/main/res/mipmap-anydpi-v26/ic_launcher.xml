<?xml version="1.0" encoding="utf-8"?>
<!-- Blue adaptive launcher icon: gradient background + foreground artwork +
     monochrome glyph (Android 13+ themed icons). Foreground has no extra
     inset — the artwork already sits inside the 108dp safe-zone circle, so
     it renders ~19% larger on the home screen. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/brand_icon_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
