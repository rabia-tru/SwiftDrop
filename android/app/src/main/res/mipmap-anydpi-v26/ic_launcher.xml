<?xml version="1.0" encoding="utf-8"?>
<!-- Blue adaptive launcher icon: gradient background + foreground artwork +
     monochrome glyph (Android 13+ themed icons). Foreground is wrapped in a
     16% inset, matching the visible-artwork scale of the legacy raster. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/brand_icon_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="16%" />
    </foreground>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
